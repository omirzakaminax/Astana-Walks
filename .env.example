# Copy this file to .env and edit. Never commit .env.

# "ollama" (default, free, local) or "gemini" (optional, needs a key)
LLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Weak laptop: OLLAMA_MODEL=qwen3:1.7b  (use the exact name from `ollama list`)
LLM_TIMEOUT_S=120
# Cap on generated tokens and context size (see walks/config.py)
LLM_NUM_PREDICT=700
LLM_NUM_CTX=6144

# Optional Gemini API. Leave empty to disable.
# Get a key in Google AI Studio and copy a model ID that your AI Studio project shows as free.
GEMINI_API_KEY=
GEMINI_MODEL=

# Weather from Open-Meteo (free, no key). Set to 0 to switch off.
WEATHER_ENABLED=1

# Local web server
HOST=127.0.0.1
PORT=8501

# Walking model (approximate)
WALK_SPEED_M_PER_MIN=75
ROUTE_DETOUR_FACTOR=1.3

# Retrieval: "lexical" (default) or "hybrid" (adds a local multilingual embedding model; needs
# pip install -r requirements-semantic.txt). If hybrid cannot load, the app says so and uses lexical.
RETRIEVAL_MODE=lexical
SEMANTIC_MODEL=intfloat/multilingual-e5-small

# Model output: low temperature for grounded JSON; one local model call at a time.
LLM_TEMPERATURE=0.1
LLM_MAX_CONCURRENT=1
