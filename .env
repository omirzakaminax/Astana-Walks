# Copy this file to .env and edit. Never commit .env.

# "ollama" (default, free, local) or "gemini" (optional, needs a key)
LLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Recommended if your laptop can run it: OLLAMA_MODEL=qwen3:4b-instruct  (exact name from `ollama list`)
LLM_TIMEOUT_S=120

# Optional Gemini API. Leave empty to disable.
# Get a key in Google AI Studio and copy a model ID that your AI Studio project shows as free.
GEMINI_API_KEY=
GEMINI_MODEL=

# Walking model (approximate)
WALK_SPEED_M_PER_MIN=75
ROUTE_DETOUR_FACTOR=1.3
